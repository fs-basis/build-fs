+static inline int mtd64_is_positive(int64_t ll)
+{
+	DIunion u;
+
+	u.ll = ll;
+	return ((int) u.s.high > 0 || (((int) u.s.high) == 0 && ((unsigned int) u.s.low) > 0));
+}
