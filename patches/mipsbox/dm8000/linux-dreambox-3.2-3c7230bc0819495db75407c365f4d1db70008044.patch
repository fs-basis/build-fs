+		brcmnand_ctrl_write(BCHP_NAND_CMD_EXT_ADDRESS, extAddr);
+#endif
+		
+//printk("Turn on NOR\n");
+		// Turn on NOR on CS0
+		*(volatile unsigned long*) (0xb0000000|BCHP_EBI_CS_CONFIG_0) = 
+			cs0Cnfg | BCHP_EBI_CS_CONFIG_0_enable_MASK;
+
