+
+	/* SDIO */
+	BDEV_WR_RB(BCHP_CLK_SYS_PLL_1_1, 0);
+	BDEV_WR_F_RB(CLK_HIF_SDIO_CLK_PM_CTRL, DIS_HIF_SDIO_48M_CLK, 0);
