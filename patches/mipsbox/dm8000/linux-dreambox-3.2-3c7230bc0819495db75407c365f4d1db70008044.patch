+ * Flush memory transactions and put MEMC into standby
+ ***********************************************************************/
+
+	sync
+
+#if !defined(CONFIG_BRCM_PWR_HANDSHAKE)
+	li	t0, REG(BCHP_MEMC_DDR_0_SSPD_CMD)
+	li	t1, 1
+	sw	t1, 0(t0)
+
