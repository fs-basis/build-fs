+static void init_edu_buf(void)
+{
+	/* Write pattern */
+	int i;
+
+	if (!edu_buf32) {
+		edu_buf32 = (uint32_t*) kmalloc(EDU_BUF32_SIZE_B, GFP_KERNEL);
+		if (!edu_buf32) {
+			printk("%s: Out of memory\n", __FUNCTION__);
