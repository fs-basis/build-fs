+		this = (struct brcmnand_chip*) mtd->priv;
+		brcmnand_get_device(mtd, BRCMNAND_FL_XIP);
+	}
+	else
+		/* Nothing we can do without an mtd handle */
+		return;
+
+#if 0
+/* No longer used.  We now required the mtd handle */
+	else {
