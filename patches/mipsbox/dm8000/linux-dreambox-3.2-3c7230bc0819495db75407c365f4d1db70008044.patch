+	uint32_t txstat  = uart_read(port, UART_TXSTAT);
+
+	uart_write(port, UART_CONTROL, control | BCM_CONTROL_TXE);	
+	uart_write(port, UART_TXSTAT,  txstat  | BCM_TXSTAT_TIE);
