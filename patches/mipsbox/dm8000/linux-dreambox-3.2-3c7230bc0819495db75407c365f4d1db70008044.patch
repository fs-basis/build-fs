+{
+	uint32_t hif_err = 0, edu_err;
+	int ret;
+	struct brcmnand_chip *chip = mtd->priv;
+
+	/* For Erase op, use the controller version */
+	if (chip->ctrl->state != FL_WRITING) {
+		return brcmnand_ctrl_write_is_complete(mtd, outp_needBBT);  
