+		break;
+	case 1:
+		chg.new_base = CPU_PLL_MODE1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	chg.old_div = cpu_div;
+	chg.new_div = cpu_div;
+	chg.old_base = brcm_adj_cpu_khz;
+	on_each_cpu(brcm_set_cpu_speed, &chg, 1);
+
+	cpu_pll_mode = val;
+	return count;
+}
