+	/* Calculate max blocks based on 1-bit per page */
+	tmpdiv = this->mtdSize;
+	do_div(tmpdiv, this->pageSize);
+	do_div(tmpdiv, (8*this->blockSize));
+	cet->numblks = (uint32_t) tmpdiv;
