+{
+	int val;
+	struct spd_change chg;
+
+	if (sscanf(buf, "%d", &val) != 1)
+		return -EINVAL;
+
+	if (val != 1 && val != 2 && val != 4 && val != 8
+#if defined(CONFIG_BMIPS5000)
+		&& val != 16
+#endif
+			)
+		return -EINVAL;
+
+	chg.old_div = cpu_div;
+	chg.new_div = val;
+	chg.old_base = brcm_adj_cpu_khz;
+	chg.new_base = brcm_adj_cpu_khz;
+
+	on_each_cpu(brcm_set_cpu_speed, &chg, 1);
+	cpu_div = val;
+	return count;
+}
