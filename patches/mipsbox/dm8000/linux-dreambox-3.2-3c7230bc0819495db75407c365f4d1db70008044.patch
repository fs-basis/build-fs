+/* --------------------------------------------------------------------------
+    Name: bcmemac_net_timeout
+ Purpose: 
+-------------------------------------------------------------------------- */
+static void bcmemac_net_timeout(struct net_device *dev)
+{
+	ASSERT(dev != NULL);
+
+	TRACE(("%s: bcmemac_net_timeout\n", dev->name));
+
+	dev->trans_start = jiffies;
+
+	netif_wake_queue(dev);
+}
