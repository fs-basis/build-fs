+	cet->sign = (this->bbt_td->options & NAND_BBT_LASTBLOCK) ? 1 : -1;
+	/* For flash size <= 512MB BBT and CET share the last 1MB
+	   for flash size > 512MB CET is at the 512th MB of flash */
+#if 0
