+	 */
+	.irq =			ehci_irq,
+	.flags =		HCD_USB2 | HCD_MEMORY,
+
+	/*
+	 * basic lifecycle operations
+	 */
+	.reset =		ehci_brcm_reset,
+	.start =		ehci_run,
+	.stop =			ehci_stop,
+	.shutdown =		ehci_brcm_shutdown,
+
+	/*
