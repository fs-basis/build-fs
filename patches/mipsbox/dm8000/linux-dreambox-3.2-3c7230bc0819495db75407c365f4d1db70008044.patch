+		unsigned long mask:4;
+		unsigned long unused:12;
+#endif
+	} pattern;
+};
+
+/* used by ioctl call */
+struct acpi_data {
+	/* current filter index */
+	int fltr_index;
+	/* pointer to the pattern data.*/
+	union acpi_pattern *p_data;
+	/* total count of the data */
+	int count;
+};
