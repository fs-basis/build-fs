+	uint32_t rxstat  = uart_read(port, UART_RXSTAT);
+
+	uart_write(port, UART_CONTROL, control & ~(BCM_CONTROL_RXE));
+	uart_write(port, UART_RXSTAT,  rxstat  & ~(BCM_RXSTAT_RIE));
+}
