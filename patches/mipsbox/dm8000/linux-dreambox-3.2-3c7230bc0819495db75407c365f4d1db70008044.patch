+static int k2_sata_runtime_idle(struct device *dev)
+{
+	dev_printk(KERN_DEBUG, dev, "%s [%lu] disabling the SATA clock\n",
+		__func__, jiffies);
+	return 0; /* ignored by pm core */
+}
