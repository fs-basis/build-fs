+	nop
+
+	bal	dputc
+	li	a0, 'w'
+
+	li	s1, 4
+1:	li	a0, (27000000 * 30)
+	bal	delay
+	addiu	s1, -1
+	bnez	s1, 1b
+	nop
+
+	bal	dputc
+	li	a0, 'W'
+
