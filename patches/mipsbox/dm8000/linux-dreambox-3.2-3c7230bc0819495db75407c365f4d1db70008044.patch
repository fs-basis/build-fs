+#define XTALFREQ		27000000
+#define REG_OFFSET		(0xa0000000 | BCHP_PHYSICAL_OFFSET)
+#define REG(x)			(REG_OFFSET + (x))
+#define UPG_USEC_TICKS		(XTALFREQ / 1000000)
