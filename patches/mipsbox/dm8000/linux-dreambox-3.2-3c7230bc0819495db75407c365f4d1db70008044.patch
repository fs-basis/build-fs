+static void bcmemac_link_timer(unsigned long arg)
+{
+	BcmEnet_devctrl *pDevCtrl = (BcmEnet_devctrl *) arg;
+
+	schedule_work(&pDevCtrl->link_status_work);
+	mod_timer(&pDevCtrl->timer, jiffies + HZ);
+}
