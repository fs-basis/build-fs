+# lock the asm section into the I-cache
+	move	s0, a0
+	addiu	t1, s0, -1
+	not	t1
+
+	la	t0, brcm_pm_standby_asm
+	and	t0, t1
+
+	la	t2, passiveIRQ_end
+	and	t2, t1
+
+1:	cache	0x1c, 0(t0)
+	bne	t0, t2, 1b
+	addu	t0, s0
