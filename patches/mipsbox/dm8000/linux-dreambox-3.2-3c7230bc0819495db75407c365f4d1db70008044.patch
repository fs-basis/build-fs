+	li	t1, 0x0f
+#else
+	li	t1, 0x0b
+#endif
+	sw	zero, 0(t0)
+	lw	zero, 0(t0)
+	sw	t1, 0(t0)
+	lw	t1, 0(t0)
+
+/***********************************************************************
+ * Wait for interrupt
+ ***********************************************************************/
+
+wait_loop:
+# enable int2 and then wait for an interrupt
+	mfc0	t0, CP0_STATUS
+# save cp0 sr
+	move	s2, t0
+
+	li	t1, ~(ST0_IM | ST0_IE)
+	and	t0, t1
