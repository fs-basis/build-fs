+#define SIOCSACPICANCEL		(SIOCDEVPRIVATE + 3)
+/* get ACPI pattern */
+#define SIOCGPATTERN		(SIOCDEVPRIVATE + 4)
+/* set ACPI pattern */
+#define SIOCSPATTERN		(SIOCDEVPRIVATE + 5)
